# Environment Variables Template
# Copy this file to .env and replace placeholder values with your real configuration

SECRET_KEY=your-custom-secure-secret-key-here
DEBUG=False
ALLOWED_HOSTS=linear-algebra-website.vercel.app,localhost,127.0.0.1

# Database Configuration (Defaults to SQLite in local/tmp)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Email Server Settings (For Production Password Resets)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
